// ZatGo AI Marketing: database schema.
// Conventions: see docs/DATABASE_DESIGN.md. Every tenant-owned model has `organizationId`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity (Better Auth core) ─────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  locale        String   @default("en")
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  members           Member[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  files             StoredFile[]
  aiUsage           AiUsage[]
  generationJobs    GenerationJob[]
  designs           Design[]
  designVersions    DesignVersion[]
  copyAssets        CopyAsset[]
  ownedLeads        Lead[]             @relation("LeadOwner")
  ownedContacts     Contact[]          @relation("ContactOwner")
  ownedCompanies    Company[]          @relation("CompanyOwner")
  ownedDeals        Deal[]             @relation("DealOwner")
  activities        Activity[]         @relation("ActivityOwner")
  createdActs       Activity[]         @relation("ActivityCreator")
  crmImports        CrmImport[]
  socialConnections SocialConnection[]
  socialAccounts    SocialAccount[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── Tenancy (Better Auth organization plugin + app fields) ─────────────────────────────

model Organization {
  id              String   @id
  name            String
  slug            String   @unique
  logo            String?
  metadata        String?
  website         String?
  industry        String?
  timezone        String   @default("Asia/Kolkata")
  defaultLanguage String   @default("en")
  currency        String   @default("INR")
  /// { textProvider?: string, imageProvider?: string } — preferred AI providers (null = platform default order)
  aiSettings      Json?
  /// CRM settings, e.g. { scoring: ScoringSettings }
  crmSettings     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  members           Member[]
  invitations       Invitation[]
  workspaces        Workspace[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  files             StoredFile[]
  aiUsage           AiUsage[]
  generationJobs    GenerationJob[]
  brandKits         BrandKit[]
  designs           Design[]
  templates         Template[]
  copyAssets        CopyAsset[]
  leads             Lead[]
  contacts          Contact[]
  companies         Company[]
  pipelines         Pipeline[]
  deals             Deal[]
  activities        Activity[]
  crmImports        CrmImport[]
  socialConnections SocialConnection[]
  socialAccounts    SocialAccount[]
  invoices          Invoice[]
  payments          Payment[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Workspace {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandKits    BrandKit[]
  designs      Design[]
  copyAssets   CopyAsset[]

  @@index([organizationId])
  @@map("workspace")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             String   @id @default(uuid(7))
  organizationId String?
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// ───────────────────────────── Billing & usage ─────────────────────────────

enum PlanCode {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id                    String   @id @default(uuid(7))
  code                  PlanCode @unique
  name                  String
  description           String?
  priceMonthly          Decimal? @db.Decimal(14, 2)
  priceYearly           Decimal? @db.Decimal(14, 2)
  currency              String   @default("INR")
  /// { aiCredits, storageMb, members, socialAccounts, workspaces }. -1 = unlimited
  limits                Json
  isPublic              Boolean  @default(true)
  sortOrder             Int      @default(0)
  /// Razorpay plan ids (created in the Razorpay dashboard), per billing interval
  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")

  @@map("plan")
}

model Subscription {
  id                  String             @id @default(uuid(7))
  organizationId      String             @unique
  planId              String
  status              SubscriptionStatus @default(ACTIVE)
  interval            BillingInterval    @default(MONTHLY)
  provider            String?
  externalId          String?            @unique
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime?
  trialEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  /// Plan (and interval) the subscription switches to at the end of the current period (scheduled downgrade)
  pendingPlanId       String?
  pendingInterval     BillingInterval?
  /// PAST_DUE subscriptions keep access until this date
  graceUntil          DateTime?
  providerCustomerId  String?
  trialReminderSentAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  invoices     Invoice[]

  @@index([status])
  @@map("subscription")
}

enum AICapability {
  TEXT
  IMAGE
  VIDEO
  EMBEDDING
}

enum AiUsageStatus {
  SUCCEEDED
  FAILED
}

model AiUsage {
  id             String        @id @default(uuid(7))
  organizationId String
  userId         String?
  capability     AICapability
  provider       String
  model          String
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  units          Int           @default(0)
  costMicroUsd   BigInt        @default(0)
  credits        Int           @default(0)
  status         AiUsageStatus
  /// What the generation was for, e.g. "playground", "copywriter", "design"
  purpose        String?
  jobId          String?
  /// Normalised failure kind for FAILED attempts (rate_limited, refused, unavailable, …)
  errorKind      String?
  latencyMs      Int?
  createdAt      DateTime      @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  job          GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("ai_usage")
}

// ───────────────────────────── Storage ─────────────────────────────

enum FileStatus {
  PENDING
  UPLOADED
  DELETED
}

model StoredFile {
  id             String     @id @default(uuid(7))
  organizationId String
  uploadedById   String?
  key            String     @unique
  bucket         String
  fileName       String
  mimeType       String
  sizeBytes      Int
  purpose        String
  status         FileStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("stored_file")
}

// ───────────────────────────── Invoices, payments & webhook log ─────────────────────────────

model Invoice {
  id             String    @id @default(uuid(7))
  organizationId String
  subscriptionId String?
  provider       String
  externalId     String    @unique
  number         String?
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  status         String
  periodStart    DateTime?
  periodEnd      DateTime?
  invoiceUrl     String?
  issuedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId, issuedAt])
  @@map("invoice")
}

model Payment {
  id             String   @id @default(uuid(7))
  organizationId String
  invoiceId      String?
  provider       String
  externalId     String   @unique
  amount         Decimal  @db.Decimal(14, 2)
  currency       String
  status         String
  method         String?
  errorReason    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("payment")
}

/// Every verified payment-provider webhook, for idempotency and auditing. Platform-level (not tenant scoped).
model BillingEvent {
  id             String    @id @default(uuid(7))
  provider       String
  eventId        String
  type           String
  organizationId String?
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([organizationId])
  @@map("billing_event")
}

// ───────────────────────────── AI generation jobs ─────────────────────────────

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Asynchronous AI work (images now; long text, video later). Processed by the `ai-generation` BullMQ queue.
model GenerationJob {
  id             String           @id @default(uuid(7))
  organizationId String
  userId         String?
  type           AICapability
  status         GenerationStatus @default(QUEUED)
  purpose        String
  input          Json
  /// TEXT: { text }, IMAGE: { fileIds: string[] }
  output         Json?
  errorCode      String?
  errorMessage   String?
  provider       String?
  model          String?
  credits        Int              @default(0)
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  usage        AiUsage[]

  @@index([organizationId, createdAt])
  @@map("generation_job")
}

// ───────────────────────────── AI Design Studio ─────────────────────────────

model BrandKit {
  id             String   @id @default(uuid(7))
  organizationId String
  workspaceId    String?
  name           String
  isDefault      Boolean  @default(false)
  logoFileId     String?
  /// { primary, secondary, accent, background, text } as #RRGGBB
  colors         Json
  /// { heading, body } font families from FONT_CATALOG
  fonts          Json
  tagline        String?
  website        String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  guidelines     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  designs      Design[]
  copyAssets   CopyAsset[]

  @@index([organizationId])
  @@map("brand_kit")
}

enum DesignStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

model Design {
  id                String       @id @default(uuid(7))
  organizationId    String
  workspaceId       String
  brandKitId        String?
  title             String
  prompt            String?
  sizePreset        String
  width             Int
  height            Int
  language          String       @default("en")
  /// Layered design document (designDocumentSchema)
  document          Json
  /// Optimistic concurrency counter, incremented on every document/title save
  revision          Int          @default(0)
  status            DesignStatus @default(DRAFT)
  generationJobId   String?
  /// The generate request (size, language, aiBackground, occasion) the worker reads
  generationOptions Json?
  errorCode         String?
  errorMessage      String?
  thumbnailFileId   String?
  caption           String?
  hashtags          String[]     @default([])
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandKit     BrandKit?       @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions     DesignVersion[]
  copyAssets   CopyAsset[]

  @@index([organizationId, updatedAt])
  @@map("design")
}

model DesignVersion {
  id             String   @id @default(uuid(7))
  organizationId String
  designId       String
  revision       Int
  document       Json
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  design    Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([designId, createdAt])
  @@map("design_version")
}

model Template {
  id              String   @id @default(uuid(7))
  organizationId  String
  name            String
  category        String   @default("General")
  sizePreset      String
  width           Int
  height          Int
  document        Json
  thumbnailFileId String?
  createdById     String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("template")
}

/// Saved marketing copy (Phase 6). Reusable by campaigns (P12), social posts (P10) and messaging (P14).
model CopyAsset {
  id             String    @id @default(uuid(7))
  organizationId String
  workspaceId    String
  kind           String
  content        String
  hashtags       String[]  @default([])
  language       String    @default("en")
  tone           String?
  platform       String    @default("generic")
  goal           String?
  audience       String?
  brief          String?
  /// Sibling variants the content was picked from
  variants       Json?
  favorite       Boolean   @default(false)
  brandKitId     String?
  sourceDesignId String?
  /// Campaign link; foreign key added with campaigns in Phase 12
  campaignId     String?
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandKit     BrandKit?    @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  sourceDesign Design?      @relation(fields: [sourceDesignId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, updatedAt])
  @@index([organizationId, kind])
  @@map("copy_asset")
}

// ───────────────────────────── CRM (Phase 7) ─────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum Lifecycle {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  NOTE
  TASK
  FOLLOW_UP
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Company {
  id             String    @id @default(uuid(7))
  organizationId String
  name           String
  nameNormalized String?
  website        String?
  industry       String?
  size           String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  tags           String[]  @default([])
  customFields   Json      @default("{}")
  ownerId        String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]

  @@index([organizationId, ownerId])
  @@index([organizationId, nameNormalized])
  @@map("company")
}

model Contact {
  id              String    @id @default(uuid(7))
  organizationId  String
  companyId       String?
  firstName       String
  lastName        String?
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  whatsapp        String?
  jobTitle        String?
  lifecycle       Lifecycle @default(PROSPECT)
  source          String    @default("other")
  notes           String?
  tags            String[]  @default([])
  customFields    Json      @default("{}")
  ownerId         String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  /// Marketing consent per channel (Phase 14)
  consent         Json?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  leads        Lead[]

  @@index([organizationId, ownerId])
  @@index([organizationId, lifecycle])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
  @@map("contact")
}

model Lead {
  id                 String     @id @default(uuid(7))
  organizationId     String
  firstName          String
  lastName           String?
  email              String?
  emailNormalized    String?
  phone              String?
  phoneNormalized    String?
  whatsapp           String?
  jobTitle           String?
  company            String?
  website            String?
  industry           String?
  city               String?
  country            String?
  status             LeadStatus @default(NEW)
  source             String     @default("other")
  sourceDetail       String?
  notes              String?
  tags               String[]   @default([])
  customFields       Json       @default("{}")
  ownerId            String?
  /// Rule-based lead score 0–100 (Phase 8), with grade and explanation
  score              Int?
  scoreReason        String?
  scoreGrade         String?
  scoreBreakdown     Json?
  scoredAt           DateTime?
  /// Cached AI insights (summary, next best action, drafted message)
  aiInsights         Json?
  aiInsightsAt       DateTime?
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  convertedContactId String?
  convertedDealId    String?
  convertedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedContact Contact?     @relation(fields: [convertedContactId], references: [id], onDelete: SetNull)
  activities       Activity[]
  deals            Deal[]

  @@index([organizationId, ownerId])
  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
  @@map("lead")
}

model Pipeline {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipeline")
}

model PipelineStage {
  id             String    @id @default(uuid(7))
  organizationId String
  pipelineId     String
  name           String
  order          Int
  probability    Int       @default(0)
  kind           StageKind @default(OPEN)
  createdAt      DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, order])
  @@map("pipeline_stage")
}

model Deal {
  id              String     @id @default(uuid(7))
  organizationId  String
  name            String
  value           Decimal    @default(0) @db.Decimal(14, 2)
  currency        String     @default("INR")
  pipelineId      String
  stageId         String
  /// Order within the stage column (fractional for cheap inserts)
  position        Float      @default(0)
  probability     Int        @default(0)
  status          DealStatus @default(OPEN)
  lostReason      String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  source          String?
  contactId       String?
  companyId       String?
  leadId          String?
  tags            String[]   @default([])
  notes           String?
  ownerId         String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner        User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities   Activity[]

  @@index([organizationId, ownerId])
  @@index([organizationId, status])
  @@index([stageId, position])
  @@map("deal")
}

model Activity {
  id             String       @id @default(uuid(7))
  organizationId String
  type           ActivityType
  subject        String
  body           String?
  dueAt          DateTime?
  completedAt    DateTime?
  priority       Priority     @default(MEDIUM)
  outcome        String?
  ownerId        String?
  createdById    String?
  leadId         String?
  contactId      String?
  companyId      String?
  dealId         String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, ownerId, dueAt])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("activity")
}

/// CSV import runs (processed by the `crm-import` queue).
model CrmImport {
  id             String           @id @default(uuid(7))
  organizationId String
  userId         String?
  entity         String
  fileId         String
  options        Json
  status         GenerationStatus @default(QUEUED)
  total          Int              @default(0)
  processed      Int              @default(0)
  created        Int              @default(0)
  updated        Int              @default(0)
  skipped        Int              @default(0)
  errors         Json             @default("[]")
  error          String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("crm_import")
}

// ───────────────────────────── Social accounts (Phase 9) ─────────────────────────────

enum SocialConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  ERROR
  DISCONNECTED
}

/// One OAuth grant (a person authorised the app on a platform). Tokens are AES-256-GCM encrypted.
model SocialConnection {
  id                    String                 @id @default(uuid(7))
  organizationId        String
  provider              String
  connectedById         String?
  externalUserId        String
  displayName           String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                String[]               @default([])
  status                SocialConnectionStatus @default(ACTIVE)
  lastRefreshedAt       DateTime?
  lastError             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?           @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  accounts     SocialAccount[]

  @@unique([organizationId, provider, externalUserId])
  @@index([organizationId])
  @@map("social_connection")
}

/// A publishing destination: Facebook Page, Instagram Business account, LinkedIn Page or YouTube channel.
model SocialAccount {
  id                    String              @id @default(uuid(7))
  organizationId        String
  connectionId          String
  platform              String
  externalId            String
  name                  String
  username              String?
  avatarUrl             String?
  /// Account-level token where the platform issues one (Meta page token), encrypted
  accountTokenEncrypted String?
  capabilities          Json                @default("{}")
  status                SocialAccountStatus @default(ACTIVE)
  lastCheckedAt         DateTime?
  lastError             String?
  /// Workspaces that may publish to this account (empty = all)
  workspaceIds          String[]            @default([])
  connectedById         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectedBy  User?            @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, status])
  @@map("social_account")
}

/// Verified platform webhook deliveries (Meta), kept for publishing/analytics phases. Platform-level (not tenant scoped).
model SocialWebhookEvent {
  id             String    @id @default(uuid(7))
  provider       String
  object         String?
  objectId       String?
  field          String?
  payload        Json
  organizationId String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([provider, receivedAt])
  @@map("social_webhook_event")
}
