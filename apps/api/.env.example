# ── Core ──
NODE_ENV=development
PORT=4000
# Public URL of the API (Better Auth base URL)
API_URL=http://localhost:4000
# Origin(s) of the web app, comma-separated (CORS + Better Auth trusted origins)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database / Redis ──
DATABASE_URL=postgresql://zatma:zatma@localhost:5432/zatma
REDIS_URL=redis://localhost:6379

# ── Auth ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage (S3-compatible: MinIO locally, Cloudflare R2 in production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=zatma-assets
S3_ACCESS_KEY_ID=zatma
S3_SECRET_ACCESS_KEY=zatma-secret
S3_FORCE_PATH_STYLE=true

# ── AI providers (Phase 4; server-side only, never exposed to the browser) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Payments (Phase 2) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
