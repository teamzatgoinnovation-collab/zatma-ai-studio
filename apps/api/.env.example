# ── Core ──
NODE_ENV=development
PORT=4000
# Public URL of the API (Better Auth base URL)
API_URL=http://localhost:4000
# Origin(s) of the web app, comma-separated (CORS + Better Auth trusted origins)
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ── Database / Redis ──
DATABASE_URL=postgresql://zatma:zatma@localhost:5432/zatma
REDIS_URL=redis://localhost:6379

# ── Auth ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the web app (used in email links). Defaults to the first WEB_ORIGIN.
WEB_URL=http://localhost:3000

# ── Email ──
# capture = development inbox (GET /api/v1/dev/emails); resend = real delivery (required in production)
EMAIL_TRANSPORT=capture
RESEND_API_KEY=
EMAIL_FROM="ZatGo AI Marketing <no-reply@zatgoinnovation.com>"
REQUIRE_EMAIL_VERIFICATION=true

# ── Trials & billing ──
# Plan new organizations trial (NONE to disable) and its length in days
TRIAL_PLAN=PROFESSIONAL
TRIAL_DAYS=14
# Days a PAST_DUE subscription keeps access before falling back to FREE
BILLING_GRACE_DAYS=7

# ── Storage (S3-compatible: moto S3 emulator locally (docker compose service "s3"), Cloudflare R2 in production) ──
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=zatma-assets
S3_ACCESS_KEY_ID=zatma
S3_SECRET_ACCESS_KEY=zatma-secret
S3_FORCE_PATH_STYLE=true

# ── AI providers (server-side only, never exposed to the browser) ──
# A provider is enabled when its key is set. Fallback order (first = default):
AI_TEXT_PROVIDERS=anthropic,openai,gemini
AI_IMAGE_PROVIDERS=openai,gemini
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5-5
# Claude effort (low | medium | high): depth vs. cost/latency
ANTHROPIC_EFFORT=medium
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Payments (Phase 2) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
