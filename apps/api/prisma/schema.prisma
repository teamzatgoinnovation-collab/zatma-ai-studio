// ZatGo AI Marketing: database schema.
// Conventions: see docs/DATABASE_DESIGN.md. Every tenant-owned model has `organizationId`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity (Better Auth core) ─────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  locale        String   @default("en")
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions           Session[]
  accounts           Account[]
  members            Member[]
  invitations        Invitation[]
  auditLogs          AuditLog[]
  files              StoredFile[]
  aiUsage            AiUsage[]
  generationJobs     GenerationJob[]
  designs            Design[]
  designVersions     DesignVersion[]
  copyAssets         CopyAsset[]
  ownedLeads         Lead[]             @relation("LeadOwner")
  ownedContacts      Contact[]          @relation("ContactOwner")
  ownedCompanies     Company[]          @relation("CompanyOwner")
  ownedDeals         Deal[]             @relation("DealOwner")
  activities         Activity[]         @relation("ActivityOwner")
  createdActs        Activity[]         @relation("ActivityCreator")
  crmImports         CrmImport[]
  socialConnections  SocialConnection[]
  socialAccounts     SocialAccount[]
  socialPosts        SocialPost[]       @relation("PostCreator")
  approvedPosts      SocialPost[]       @relation("PostApprover")
  adCampaigns        AdCampaign[]       @relation("AdCampaignCreator")
  activatedCampaigns AdCampaign[]       @relation("AdCampaignActivator")
  adApprovals        AdApproval[]
  ownedCampaigns     Campaign[]         @relation("CampaignOwner")
  createdCampaigns   Campaign[]         @relation("CampaignCreator")
  campaignTasks      CampaignTask[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── Tenancy (Better Auth organization plugin + app fields) ─────────────────────────────

model Organization {
  id              String   @id
  name            String
  slug            String   @unique
  logo            String?
  metadata        String?
  website         String?
  industry        String?
  timezone        String   @default("Asia/Kolkata")
  defaultLanguage String   @default("en")
  currency        String   @default("INR")
  /// { textProvider?: string, imageProvider?: string } — preferred AI providers (null = platform default order)
  aiSettings      Json?
  /// CRM settings, e.g. { scoring: ScoringSettings }
  crmSettings     Json?
  /// Publishing settings (socialSettingsSchema), e.g. { requireApproval }
  socialSettings  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  members           Member[]
  invitations       Invitation[]
  workspaces        Workspace[]
  subscription      Subscription?
  auditLogs         AuditLog[]
  files             StoredFile[]
  aiUsage           AiUsage[]
  generationJobs    GenerationJob[]
  brandKits         BrandKit[]
  designs           Design[]
  templates         Template[]
  copyAssets        CopyAsset[]
  leads             Lead[]
  contacts          Contact[]
  companies         Company[]
  pipelines         Pipeline[]
  deals             Deal[]
  activities        Activity[]
  crmImports        CrmImport[]
  socialConnections SocialConnection[]
  socialAccounts    SocialAccount[]
  socialPosts       SocialPost[]
  socialPostTargets SocialPostTarget[]
  adAccounts        AdAccount[]
  adCampaigns       AdCampaign[]
  adGroups          AdGroup[]
  ads               Ad[]
  adInsights        AdInsightDaily[]
  adApprovals       AdApproval[]
  invoices          Invoice[]
  payments          Payment[]
  campaigns         Campaign[]
  campaignPlans     CampaignChannelPlan[]
  campaignAssets    CampaignAsset[]
  campaignTasks     CampaignTask[]
  trackedLinks      TrackedLink[]
  trackedLinkDays   TrackedLinkClickDaily[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Workspace {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandKits    BrandKit[]
  designs      Design[]
  copyAssets   CopyAsset[]
  socialPosts  SocialPost[]
  adCampaigns  AdCampaign[]
  campaigns    Campaign[]

  @@index([organizationId])
  @@map("workspace")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             String   @id @default(uuid(7))
  organizationId String?
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// ───────────────────────────── Billing & usage ─────────────────────────────

enum PlanCode {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id                    String   @id @default(uuid(7))
  code                  PlanCode @unique
  name                  String
  description           String?
  priceMonthly          Decimal? @db.Decimal(14, 2)
  priceYearly           Decimal? @db.Decimal(14, 2)
  currency              String   @default("INR")
  /// { aiCredits, storageMb, members, socialAccounts, workspaces }. -1 = unlimited
  limits                Json
  isPublic              Boolean  @default(true)
  sortOrder             Int      @default(0)
  /// Razorpay plan ids (created in the Razorpay dashboard), per billing interval
  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")

  @@map("plan")
}

model Subscription {
  id                  String             @id @default(uuid(7))
  organizationId      String             @unique
  planId              String
  status              SubscriptionStatus @default(ACTIVE)
  interval            BillingInterval    @default(MONTHLY)
  provider            String?
  externalId          String?            @unique
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime?
  trialEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  /// Plan (and interval) the subscription switches to at the end of the current period (scheduled downgrade)
  pendingPlanId       String?
  pendingInterval     BillingInterval?
  /// PAST_DUE subscriptions keep access until this date
  graceUntil          DateTime?
  providerCustomerId  String?
  trialReminderSentAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  invoices     Invoice[]

  @@index([status])
  @@map("subscription")
}

enum AICapability {
  TEXT
  IMAGE
  VIDEO
  EMBEDDING
}

enum AiUsageStatus {
  SUCCEEDED
  FAILED
}

model AiUsage {
  id             String        @id @default(uuid(7))
  organizationId String
  userId         String?
  capability     AICapability
  provider       String
  model          String
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  units          Int           @default(0)
  costMicroUsd   BigInt        @default(0)
  credits        Int           @default(0)
  status         AiUsageStatus
  /// What the generation was for, e.g. "playground", "copywriter", "design"
  purpose        String?
  jobId          String?
  /// Normalised failure kind for FAILED attempts (rate_limited, refused, unavailable, …)
  errorKind      String?
  latencyMs      Int?
  createdAt      DateTime      @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  job          GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("ai_usage")
}

// ───────────────────────────── Storage ─────────────────────────────

enum FileStatus {
  PENDING
  UPLOADED
  DELETED
}

model StoredFile {
  id             String     @id @default(uuid(7))
  organizationId String
  uploadedById   String?
  key            String     @unique
  bucket         String
  fileName       String
  mimeType       String
  sizeBytes      Int
  purpose        String
  status         FileStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  campaignUses CampaignAsset[]

  @@index([organizationId])
  @@map("stored_file")
}

// ───────────────────────────── Invoices, payments & webhook log ─────────────────────────────

model Invoice {
  id             String    @id @default(uuid(7))
  organizationId String
  subscriptionId String?
  provider       String
  externalId     String    @unique
  number         String?
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  status         String
  periodStart    DateTime?
  periodEnd      DateTime?
  invoiceUrl     String?
  issuedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId, issuedAt])
  @@map("invoice")
}

model Payment {
  id             String   @id @default(uuid(7))
  organizationId String
  invoiceId      String?
  provider       String
  externalId     String   @unique
  amount         Decimal  @db.Decimal(14, 2)
  currency       String
  status         String
  method         String?
  errorReason    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("payment")
}

/// Every verified payment-provider webhook, for idempotency and auditing. Platform-level (not tenant scoped).
model BillingEvent {
  id             String    @id @default(uuid(7))
  provider       String
  eventId        String
  type           String
  organizationId String?
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([organizationId])
  @@map("billing_event")
}

// ───────────────────────────── AI generation jobs ─────────────────────────────

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Asynchronous AI work (images now; long text, video later). Processed by the `ai-generation` BullMQ queue.
model GenerationJob {
  id             String           @id @default(uuid(7))
  organizationId String
  userId         String?
  type           AICapability
  status         GenerationStatus @default(QUEUED)
  purpose        String
  input          Json
  /// TEXT: { text }, IMAGE: { fileIds: string[] }
  output         Json?
  errorCode      String?
  errorMessage   String?
  provider       String?
  model          String?
  credits        Int              @default(0)
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  usage        AiUsage[]

  @@index([organizationId, createdAt])
  @@map("generation_job")
}

// ───────────────────────────── AI Design Studio ─────────────────────────────

model BrandKit {
  id             String   @id @default(uuid(7))
  organizationId String
  workspaceId    String?
  name           String
  isDefault      Boolean  @default(false)
  logoFileId     String?
  /// { primary, secondary, accent, background, text } as #RRGGBB
  colors         Json
  /// { heading, body } font families from FONT_CATALOG
  fonts          Json
  tagline        String?
  website        String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  guidelines     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  designs      Design[]
  copyAssets   CopyAsset[]

  @@index([organizationId])
  @@map("brand_kit")
}

enum DesignStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

model Design {
  id                String       @id @default(uuid(7))
  organizationId    String
  workspaceId       String
  brandKitId        String?
  title             String
  prompt            String?
  sizePreset        String
  width             Int
  height            Int
  language          String       @default("en")
  /// Layered design document (designDocumentSchema)
  document          Json
  /// Optimistic concurrency counter, incremented on every document/title save
  revision          Int          @default(0)
  status            DesignStatus @default(DRAFT)
  generationJobId   String?
  /// The generate request (size, language, aiBackground, occasion) the worker reads
  generationOptions Json?
  errorCode         String?
  errorMessage      String?
  thumbnailFileId   String?
  caption           String?
  hashtags          String[]     @default([])
  /// Campaign this design belongs to (Phase 12)
  campaignId        String?
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandKit     BrandKit?       @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions     DesignVersion[]
  copyAssets   CopyAsset[]
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignUses CampaignAsset[]

  @@index([organizationId, updatedAt])
  @@index([campaignId])
  @@map("design")
}

model DesignVersion {
  id             String   @id @default(uuid(7))
  organizationId String
  designId       String
  revision       Int
  document       Json
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  design    Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([designId, createdAt])
  @@map("design_version")
}

model Template {
  id              String   @id @default(uuid(7))
  organizationId  String
  name            String
  category        String   @default("General")
  sizePreset      String
  width           Int
  height          Int
  document        Json
  thumbnailFileId String?
  createdById     String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("template")
}

/// Saved marketing copy (Phase 6). Reusable by campaigns (P12), social posts (P10) and messaging (P14).
model CopyAsset {
  id             String    @id @default(uuid(7))
  organizationId String
  workspaceId    String
  kind           String
  content        String
  hashtags       String[]  @default([])
  language       String    @default("en")
  tone           String?
  platform       String    @default("generic")
  goal           String?
  audience       String?
  brief          String?
  /// Sibling variants the content was picked from
  variants       Json?
  favorite       Boolean   @default(false)
  brandKitId     String?
  sourceDesignId String?
  /// Campaign this belongs to (Phase 12)
  campaignId     String?
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandKit     BrandKit?       @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  sourceDesign Design?         @relation(fields: [sourceDesignId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignUses CampaignAsset[]

  @@index([organizationId, updatedAt])
  @@index([organizationId, kind])
  @@index([campaignId])
  @@map("copy_asset")
}

// ───────────────────────────── CRM (Phase 7) ─────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum Lifecycle {
  LEAD
  PROSPECT
  CUSTOMER
  CHURNED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  NOTE
  TASK
  FOLLOW_UP
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Company {
  id             String    @id @default(uuid(7))
  organizationId String
  name           String
  nameNormalized String?
  website        String?
  industry       String?
  size           String?
  phone          String?
  email          String?
  address        String?
  city           String?
  country        String?
  tags           String[]  @default([])
  customFields   Json      @default("{}")
  ownerId        String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]

  @@index([organizationId, ownerId])
  @@index([organizationId, nameNormalized])
  @@map("company")
}

model Contact {
  id              String    @id @default(uuid(7))
  organizationId  String
  companyId       String?
  firstName       String
  lastName        String?
  email           String?
  emailNormalized String?
  phone           String?
  phoneNormalized String?
  whatsapp        String?
  jobTitle        String?
  lifecycle       Lifecycle @default(PROSPECT)
  source          String    @default("other")
  notes           String?
  tags            String[]  @default([])
  customFields    Json      @default("{}")
  ownerId         String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  /// Marketing consent per channel (Phase 14)
  consent         Json?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  leads        Lead[]

  @@index([organizationId, ownerId])
  @@index([organizationId, lifecycle])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
  @@map("contact")
}

model Lead {
  id                 String     @id @default(uuid(7))
  organizationId     String
  firstName          String
  lastName           String?
  email              String?
  emailNormalized    String?
  phone              String?
  phoneNormalized    String?
  whatsapp           String?
  jobTitle           String?
  company            String?
  website            String?
  industry           String?
  city               String?
  country            String?
  status             LeadStatus @default(NEW)
  source             String     @default("other")
  sourceDetail       String?
  /// Campaign the lead is attributed to (first touch, Phase 12)
  campaignId         String?
  /// { source, medium, campaign, content, term }
  utm                Json?
  /// Platform id for imported leads (e.g. "meta:<leadgen id>"), unique per organization
  externalRef        String?
  notes              String?
  tags               String[]   @default([])
  customFields       Json       @default("{}")
  ownerId            String?
  /// Rule-based lead score 0–100 (Phase 8), with grade and explanation
  score              Int?
  scoreReason        String?
  scoreGrade         String?
  scoreBreakdown     Json?
  scoredAt           DateTime?
  /// Cached AI insights (summary, next best action, drafted message)
  aiInsights         Json?
  aiInsightsAt       DateTime?
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  convertedContactId String?
  convertedDealId    String?
  convertedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner            User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedContact Contact?     @relation(fields: [convertedContactId], references: [id], onDelete: SetNull)
  activities       Activity[]
  deals            Deal[]
  campaign         Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalRef])
  @@index([organizationId, ownerId])
  @@index([organizationId, status])
  @@index([organizationId, score])
  @@index([organizationId, emailNormalized])
  @@index([organizationId, phoneNormalized])
  @@index([campaignId])
  @@map("lead")
}

model Pipeline {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId])
  @@map("pipeline")
}

model PipelineStage {
  id             String    @id @default(uuid(7))
  organizationId String
  pipelineId     String
  name           String
  order          Int
  probability    Int       @default(0)
  kind           StageKind @default(OPEN)
  createdAt      DateTime  @default(now())

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, order])
  @@map("pipeline_stage")
}

model Deal {
  id              String     @id @default(uuid(7))
  organizationId  String
  name            String
  value           Decimal    @default(0) @db.Decimal(14, 2)
  currency        String     @default("INR")
  pipelineId      String
  stageId         String
  /// Order within the stage column (fractional for cheap inserts)
  position        Float      @default(0)
  probability     Int        @default(0)
  status          DealStatus @default(OPEN)
  lostReason      String?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  source          String?
  campaignId      String?
  contactId       String?
  companyId       String?
  leadId          String?
  tags            String[]   @default([])
  notes           String?
  ownerId         String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead         Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner        User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities   Activity[]
  campaign     Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, ownerId])
  @@index([organizationId, status])
  @@index([stageId, position])
  @@index([campaignId])
  @@map("deal")
}

model Activity {
  id             String       @id @default(uuid(7))
  organizationId String
  type           ActivityType
  subject        String
  body           String?
  dueAt          DateTime?
  completedAt    DateTime?
  priority       Priority     @default(MEDIUM)
  outcome        String?
  ownerId        String?
  createdById    String?
  leadId         String?
  contactId      String?
  companyId      String?
  dealId         String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, ownerId, dueAt])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
  @@index([dealId])
  @@map("activity")
}

/// CSV import runs (processed by the `crm-import` queue).
model CrmImport {
  id             String           @id @default(uuid(7))
  organizationId String
  userId         String?
  entity         String
  fileId         String
  options        Json
  status         GenerationStatus @default(QUEUED)
  total          Int              @default(0)
  processed      Int              @default(0)
  created        Int              @default(0)
  updated        Int              @default(0)
  skipped        Int              @default(0)
  errors         Json             @default("[]")
  error          String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("crm_import")
}

// ───────────────────────────── Social accounts (Phase 9) ─────────────────────────────

enum SocialConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
}

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  ERROR
  DISCONNECTED
}

/// One OAuth grant (a person authorised the app on a platform). Tokens are AES-256-GCM encrypted.
model SocialConnection {
  id                    String                 @id @default(uuid(7))
  organizationId        String
  provider              String
  connectedById         String?
  externalUserId        String
  displayName           String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                String[]               @default([])
  status                SocialConnectionStatus @default(ACTIVE)
  lastRefreshedAt       DateTime?
  lastError             String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?           @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  accounts     SocialAccount[]
  adAccounts   AdAccount[]

  @@unique([organizationId, provider, externalUserId])
  @@index([organizationId])
  @@map("social_connection")
}

/// A publishing destination: Facebook Page, Instagram Business account, LinkedIn Page or YouTube channel.
model SocialAccount {
  id                    String              @id @default(uuid(7))
  organizationId        String
  connectionId          String
  platform              String
  externalId            String
  name                  String
  username              String?
  avatarUrl             String?
  /// Account-level token where the platform issues one (Meta page token), encrypted
  accountTokenEncrypted String?
  capabilities          Json                @default("{}")
  status                SocialAccountStatus @default(ACTIVE)
  lastCheckedAt         DateTime?
  lastError             String?
  /// Workspaces that may publish to this account (empty = all)
  workspaceIds          String[]            @default([])
  connectedById         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectedBy  User?              @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  postTargets  SocialPostTarget[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, status])
  @@map("social_account")
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELED
}

enum SocialPostTargetStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

/// A social post (Phase 10): shared caption and media, published to one or more accounts (targets).
model SocialPost {
  id             String           @id @default(uuid(7))
  organizationId String
  workspaceId    String
  caption        String           @default("")
  hashtags       String[]         @default([])
  /// postMediaSchema[]: file ids with kind, type, dimensions and duration
  media          Json             @default("[]")
  status         SocialPostStatus @default(DRAFT)
  scheduledAt    DateTime?
  timezone       String?
  publishedAt    DateTime?
  sourceDesignId String?
  copyAssetId    String?
  /// Campaign this belongs to (Phase 12)
  campaignId     String?
  createdById    String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  /// Approval or rejection note
  reviewNote     String?
  /// Optimistic concurrency counter, incremented on every content save
  revision       Int              @default(0)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("PostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   User?              @relation("PostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  targets      SocialPostTarget[]
  campaign     Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, workspaceId, scheduledAt])
  @@index([campaignId])
  @@map("social_post")
}

/// One account a post goes to, with its own status, result and resumable upload state.
model SocialPostTarget {
  id              String                 @id @default(uuid(7))
  organizationId  String
  postId          String
  /// Null once the account is disconnected (the snapshot fields keep history readable)
  socialAccountId String?
  platform        String
  accountName     String
  captionOverride String?
  /// targetOptionsSchema (YouTube title, privacy, made for kids)
  options         Json                   @default("{}")
  status          SocialPostTargetStatus @default(PENDING)
  attempts        Int                    @default(0)
  /// Progress of multi-step uploads (container ids, upload sessions, created post id) so retries never repeat a step
  providerState   Json                   @default("{}")
  externalId      String?
  externalUrl     String?
  error           String?
  errorCode       String?
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         SocialPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  account      SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([postId, socialAccountId])
  @@index([organizationId, status, publishedAt])
  @@map("social_post_target")
}

enum AdPlatform {
  META
  GOOGLE
}

enum AdCampaignStatus {
  DRAFT
  PUBLISHING
  PAUSED
  ACTIVE
  COMPLETED
  ARCHIVED
  ERROR
}

enum AdBudgetType {
  DAILY
  LIFETIME
}

/// A Meta ad account or Google Ads customer the organization can run campaigns in (Phase 11).
model AdAccount {
  id              String     @id @default(uuid(7))
  organizationId  String
  /// OAuth grant (social_connection with provider meta_ads / google_ads)
  connectionId    String
  platform        AdPlatform
  externalId      String
  name            String
  currency        String
  timezone        String
  status          String     @default("ACTIVE")
  /// Google: manager account sent as login-customer-id
  loginCustomerId String?
  /// Owner/Admin-set ceiling for committed spend per UTC month, in the account currency
  monthlySpendCap Decimal?   @db.Decimal(14, 2)
  workspaceIds    String[]   @default([])
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   SocialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  campaigns    AdCampaign[]

  @@unique([organizationId, platform, externalId])
  @@map("ad_account")
}

model AdCampaign {
  id                  String           @id @default(uuid(7))
  organizationId      String
  workspaceId         String
  adAccountId         String
  platform            AdPlatform
  name                String
  /// Marketing campaign this ad campaign belongs to (Phase 12)
  marketingCampaignId String?
  objective           String
  status              AdCampaignStatus @default(DRAFT)
  source              String           @default("CREATED")
  budgetType          AdBudgetType     @default(DAILY)
  budgetAmount        Decimal          @db.Decimal(14, 2)
  currency            String
  startAt             DateTime?
  endAt               DateTime?
  externalId          String?
  /// Google budget resource name (budget changes)
  budgetExternalId    String?
  /// Resumable creation progress (ids created so far)
  syncState           Json             @default("{}")
  error               String?
  createdById         String?
  activatedById       String?
  activatedAt         DateTime?
  lastSyncedAt        DateTime?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  adAccount    AdAccount        @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("AdCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activatedBy  User?            @relation("AdCampaignActivator", fields: [activatedById], references: [id], onDelete: SetNull)
  adGroups     AdGroup[]
  insights     AdInsightDaily[]
  approvals    AdApproval[]
  campaign     Campaign?        @relation(fields: [marketingCampaignId], references: [id], onDelete: SetNull)

  @@unique([adAccountId, externalId])
  @@index([organizationId, status])
  @@index([marketingCampaignId])
  @@map("ad_campaign")
}

/// Meta ad set or Google ad group
model AdGroup {
  id             String   @id @default(uuid(7))
  organizationId String
  campaignId     String
  name           String
  status         String   @default("PAUSED")
  externalId     String?
  targeting      Json
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads          Ad[]

  @@index([campaignId])
  @@map("ad_group")
}

model Ad {
  id             String   @id @default(uuid(7))
  organizationId String
  adGroupId      String
  name           String
  status         String   @default("PAUSED")
  externalId     String?
  creative       Json
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adGroup      AdGroup      @relation(fields: [adGroupId], references: [id], onDelete: Cascade)

  @@index([adGroupId])
  @@map("ad")
}

model AdInsightDaily {
  id             String   @id @default(uuid(7))
  organizationId String
  campaignId     String
  date           DateTime @db.Date
  impressions    Int      @default(0)
  reach          Int      @default(0)
  clicks         Int      @default(0)
  spend          Decimal  @default(0) @db.Decimal(14, 2)
  conversions    Int      @default(0)
  leads          Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([organizationId, date])
  @@map("ad_insight_daily")
}

/// Every decision that lets a campaign spend (activation, resume, budget increase), with the maximum shown to the approver.
model AdApproval {
  id             String   @id @default(uuid(7))
  organizationId String
  campaignId     String
  action         String
  maxSpend       Decimal  @db.Decimal(14, 2)
  currency       String
  budgetAmount   Decimal  @db.Decimal(14, 2)
  approvedById   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@map("ad_approval")
}

/// Verified platform webhook deliveries (Meta), kept for publishing/analytics phases. Platform-level (not tenant scoped).
model SocialWebhookEvent {
  id             String    @id @default(uuid(7))
  provider       String
  object         String?
  objectId       String?
  field          String?
  payload        Json
  organizationId String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([provider, receivedAt])
  @@map("social_webhook_event")
}

// ───────────────────────────── Campaigns (Phase 12) ─────────────────────────────

enum MarketingCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

/// A multi-channel marketing campaign. Its status is a planning status and never starts any spend.
model Campaign {
  id             String                   @id @default(uuid(7))
  organizationId String
  workspaceId    String
  /// Sequence per organization; shown as CMP-0001
  number         Int
  name           String
  type           String
  objective      String                   @default("AWARENESS")
  description    String                   @default("")
  ownerId        String?
  startAt        DateTime?
  endAt          DateTime?
  timezone       String                   @default("Asia/Kolkata")
  /// Derived from the dates and manualStatus; stored so it can be filtered (recomputed on write and hourly)
  status         MarketingCampaignStatus  @default(DRAFT)
  /// PAUSED or CANCELLED when set by a person
  manualStatus   MarketingCampaignStatus?
  readyAt        DateTime?
  budgetAmount   Decimal?                 @db.Decimal(14, 2)
  currency       String                   @default("INR")
  channels       String[]                 @default([])
  /// campaignAudienceSchema (description, notes, CRM segment)
  audience       Json                     @default("{}")
  utmCampaign    String
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User?                   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User?                   @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  plans        CampaignChannelPlan[]
  assets       CampaignAsset[]
  tasks        CampaignTask[]
  links        TrackedLink[]
  linkDays     TrackedLinkClickDaily[]
  posts        SocialPost[]
  adCampaigns  AdCampaign[]
  designs      Design[]
  copyAssets   CopyAsset[]
  leads        Lead[]
  deals        Deal[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, utmCampaign])
  @@index([organizationId, startAt])
  @@map("campaign")
}

/// Per-channel plan: budget, notes and planned content (how Email/WhatsApp are planned before Phase 14)
model CampaignChannelPlan {
  id             String   @id @default(uuid(7))
  organizationId String
  campaignId     String
  channel        String
  plannedBudget  Decimal? @db.Decimal(14, 2)
  notes          String   @default("")
  /// contentPlanItemSchema[]
  content        Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, channel])
  @@map("campaign_channel_plan")
}

/// A file, design or copy collected for the campaign
model CampaignAsset {
  id             String   @id @default(uuid(7))
  organizationId String
  campaignId     String
  fileId         String?
  designId       String?
  copyAssetId    String?
  label          String   @default("")
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  file         StoredFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  design       Design?      @relation(fields: [designId], references: [id], onDelete: Cascade)
  copyAsset    CopyAsset?   @relation(fields: [copyAssetId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("campaign_asset")
}

model CampaignTask {
  id             String    @id @default(uuid(7))
  organizationId String
  campaignId     String
  title          String
  dueAt          DateTime?
  done           Boolean   @default(false)
  assigneeId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([campaignId, dueAt])
  @@map("campaign_task")
}

/// Short link /r/{slug} that redirects to the destination with UTM parameters and counts clicks (no IPs stored)
model TrackedLink {
  id             String    @id @default(uuid(7))
  organizationId String
  campaignId     String
  slug           String    @unique
  destinationUrl String
  label          String    @default("")
  channel        String    @default("other")
  utmSource      String
  utmMedium      String
  utmContent     String?
  utmTerm        String?
  clicks         Int       @default(0)
  uniqueClicks   Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  days         TrackedLinkClickDaily[]

  @@index([campaignId])
  @@map("tracked_link")
}

model TrackedLinkClickDaily {
  id             String   @id @default(uuid(7))
  organizationId String
  campaignId     String
  linkId         String
  date           DateTime @db.Date
  clicks         Int      @default(0)
  uniqueClicks   Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  link         TrackedLink  @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, date])
  @@index([campaignId, date])
  @@map("tracked_link_click_daily")
}
