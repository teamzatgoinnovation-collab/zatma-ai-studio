{
  "name": "zatma-ai-studio",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @zatma/api test:e2e",
    "db:migrate": "pnpm --filter @zatma/api db:migrate",
    "db:seed": "pnpm --filter @zatma/api db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
