// ZatGo AI Marketing: database schema.
// Conventions: see docs/DATABASE_DESIGN.md. Every tenant-owned model has `organizationId`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity (Better Auth core) ─────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  locale        String   @default("en")
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  members        Member[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  files          StoredFile[]
  aiUsage        AiUsage[]
  generationJobs GenerationJob[]
  designs        Design[]
  designVersions DesignVersion[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────────── Tenancy (Better Auth organization plugin + app fields) ─────────────────────────────

model Organization {
  id              String   @id
  name            String
  slug            String   @unique
  logo            String?
  metadata        String?
  website         String?
  industry        String?
  timezone        String   @default("Asia/Kolkata")
  defaultLanguage String   @default("en")
  currency        String   @default("INR")
  /// { textProvider?: string, imageProvider?: string } — preferred AI providers (null = platform default order)
  aiSettings      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  members        Member[]
  invitations    Invitation[]
  workspaces     Workspace[]
  subscription   Subscription?
  auditLogs      AuditLog[]
  files          StoredFile[]
  aiUsage        AiUsage[]
  generationJobs GenerationJob[]
  brandKits      BrandKit[]
  designs        Design[]
  templates      Template[]
  invoices       Invoice[]
  payments       Payment[]

  @@map("organization")
}

model Member {
  id             String   @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id
  organizationId String
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  inviterId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Workspace {
  id             String   @id @default(uuid(7))
  organizationId String
  name           String
  description    String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandKits    BrandKit[]
  designs      Design[]

  @@index([organizationId])
  @@map("workspace")
}

// ───────────────────────────── Audit ─────────────────────────────

model AuditLog {
  id             String   @id @default(uuid(7))
  organizationId String?
  actorId        String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// ───────────────────────────── Billing & usage ─────────────────────────────

enum PlanCode {
  FREE
  STARTER
  PROFESSIONAL
  BUSINESS
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Plan {
  id                    String   @id @default(uuid(7))
  code                  PlanCode @unique
  name                  String
  description           String?
  priceMonthly          Decimal? @db.Decimal(14, 2)
  priceYearly           Decimal? @db.Decimal(14, 2)
  currency              String   @default("INR")
  /// { aiCredits, storageMb, members, socialAccounts, workspaces }. -1 = unlimited
  limits                Json
  isPublic              Boolean  @default(true)
  sortOrder             Int      @default(0)
  /// Razorpay plan ids (created in the Razorpay dashboard), per billing interval
  razorpayPlanIdMonthly String?
  razorpayPlanIdYearly  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")

  @@map("plan")
}

model Subscription {
  id                  String             @id @default(uuid(7))
  organizationId      String             @unique
  planId              String
  status              SubscriptionStatus @default(ACTIVE)
  interval            BillingInterval    @default(MONTHLY)
  provider            String?
  externalId          String?            @unique
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime?
  trialEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  /// Plan (and interval) the subscription switches to at the end of the current period (scheduled downgrade)
  pendingPlanId       String?
  pendingInterval     BillingInterval?
  /// PAST_DUE subscriptions keep access until this date
  graceUntil          DateTime?
  providerCustomerId  String?
  trialReminderSentAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation("SubscriptionPlan", fields: [planId], references: [id])
  pendingPlan  Plan?        @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  invoices     Invoice[]

  @@index([status])
  @@map("subscription")
}

enum AICapability {
  TEXT
  IMAGE
  VIDEO
  EMBEDDING
}

enum AiUsageStatus {
  SUCCEEDED
  FAILED
}

model AiUsage {
  id             String        @id @default(uuid(7))
  organizationId String
  userId         String?
  capability     AICapability
  provider       String
  model          String
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  units          Int           @default(0)
  costMicroUsd   BigInt        @default(0)
  credits        Int           @default(0)
  status         AiUsageStatus
  /// What the generation was for, e.g. "playground", "copywriter", "design"
  purpose        String?
  jobId          String?
  /// Normalised failure kind for FAILED attempts (rate_limited, refused, unavailable, …)
  errorKind      String?
  latencyMs      Int?
  createdAt      DateTime      @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  job          GenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("ai_usage")
}

// ───────────────────────────── Storage ─────────────────────────────

enum FileStatus {
  PENDING
  UPLOADED
  DELETED
}

model StoredFile {
  id             String     @id @default(uuid(7))
  organizationId String
  uploadedById   String?
  key            String     @unique
  bucket         String
  fileName       String
  mimeType       String
  sizeBytes      Int
  purpose        String
  status         FileStatus @default(PENDING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("stored_file")
}

// ───────────────────────────── Invoices, payments & webhook log ─────────────────────────────

model Invoice {
  id             String    @id @default(uuid(7))
  organizationId String
  subscriptionId String?
  provider       String
  externalId     String    @unique
  number         String?
  amount         Decimal   @db.Decimal(14, 2)
  currency       String
  status         String
  periodStart    DateTime?
  periodEnd      DateTime?
  invoiceUrl     String?
  issuedAt       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId, issuedAt])
  @@map("invoice")
}

model Payment {
  id             String   @id @default(uuid(7))
  organizationId String
  invoiceId      String?
  provider       String
  externalId     String   @unique
  amount         Decimal  @db.Decimal(14, 2)
  currency       String
  status         String
  method         String?
  errorReason    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("payment")
}

/// Every verified payment-provider webhook, for idempotency and auditing. Platform-level (not tenant scoped).
model BillingEvent {
  id             String    @id @default(uuid(7))
  provider       String
  eventId        String
  type           String
  organizationId String?
  payload        Json
  processedAt    DateTime?
  error          String?
  createdAt      DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([organizationId])
  @@map("billing_event")
}

// ───────────────────────────── AI generation jobs ─────────────────────────────

enum GenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Asynchronous AI work (images now; long text, video later). Processed by the `ai-generation` BullMQ queue.
model GenerationJob {
  id             String           @id @default(uuid(7))
  organizationId String
  userId         String?
  type           AICapability
  status         GenerationStatus @default(QUEUED)
  purpose        String
  input          Json
  /// TEXT: { text }, IMAGE: { fileIds: string[] }
  output         Json?
  errorCode      String?
  errorMessage   String?
  provider       String?
  model          String?
  credits        Int              @default(0)
  createdAt      DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  usage        AiUsage[]

  @@index([organizationId, createdAt])
  @@map("generation_job")
}

// ───────────────────────────── AI Design Studio ─────────────────────────────

model BrandKit {
  id             String   @id @default(uuid(7))
  organizationId String
  workspaceId    String?
  name           String
  isDefault      Boolean  @default(false)
  logoFileId     String?
  /// { primary, secondary, accent, background, text } as #RRGGBB
  colors         Json
  /// { heading, body } font families from FONT_CATALOG
  fonts          Json
  tagline        String?
  website        String?
  phone          String?
  whatsapp       String?
  email          String?
  address        String?
  guidelines     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  designs      Design[]

  @@index([organizationId])
  @@map("brand_kit")
}

enum DesignStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

model Design {
  id                String       @id @default(uuid(7))
  organizationId    String
  workspaceId       String
  brandKitId        String?
  title             String
  prompt            String?
  sizePreset        String
  width             Int
  height            Int
  language          String       @default("en")
  /// Layered design document (designDocumentSchema)
  document          Json
  /// Optimistic concurrency counter, incremented on every document/title save
  revision          Int          @default(0)
  status            DesignStatus @default(DRAFT)
  generationJobId   String?
  /// The generate request (size, language, aiBackground, occasion) the worker reads
  generationOptions Json?
  errorCode         String?
  errorMessage      String?
  thumbnailFileId   String?
  caption           String?
  hashtags          String[]     @default([])
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandKit     BrandKit?       @relation(fields: [brandKitId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions     DesignVersion[]

  @@index([organizationId, updatedAt])
  @@map("design")
}

model DesignVersion {
  id             String   @id @default(uuid(7))
  organizationId String
  designId       String
  revision       Int
  document       Json
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())

  design    Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([designId, createdAt])
  @@map("design_version")
}

model Template {
  id              String   @id @default(uuid(7))
  organizationId  String
  name            String
  category        String   @default("General")
  sizePreset      String
  width           Int
  height          Int
  document        Json
  thumbnailFileId String?
  createdById     String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("template")
}
